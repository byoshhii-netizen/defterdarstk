# Defterdar ortam değişkenleri (hepsi isteğe bağlı)
PORT=4500

# ── Veritabanı ──────────────────────────────────────────────────────────────
# PostgreSQL bağlantısı. Tanımlıysa SQLite yerine PostgreSQL kullanılır.
# Railway'de: Variables → DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# SSL zorunlu sunucular için (Railway iç ağda gerekmez): 1 yapın ya da URL'ye ?sslmode=require ekleyin
PGSSL=

# SQLite ve yerel yedek/medya klasörü (Railway volume bağladıysanız: /data)
DATA_DIR=

# ── Güvenlik ────────────────────────────────────────────────────────────────
# Sunucu gizli anahtarı (en az 32 karakter). Şifre özetleri ve SMS/Cloudinary anahtarlarının
# şifrelenmesi buna bağlıdır; bir kez belirleyin ve değiştirmeyin.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
DEFTERDAR_ANAHTAR=
# Ters vekil arkasındaysanız 1 yapın (Railway/Render otomatik algılanır); HTTPS zorlamak için FORCE_HTTPS=1
TRUST_PROXY=
FORCE_HTTPS=

# ── Medya ───────────────────────────────────────────────────────────────────
# Tüm hesaplar için ortak Cloudinary: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Railway'de volume yoksa yüklenen dosyalar yeniden başlatmada silinir; Cloudinary önerilir.
CLOUDINARY_URL=

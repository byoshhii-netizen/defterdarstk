{
  "name": "defterdar",
  "version": "3.0.0",
  "description": "Defterdar — STK, dernek, şirket ve muhasebe büroları için bulut muhasebe ve yönetim sistemi",
  "main": "electron.js",
  "author": "Defterdar",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "dependencies": {},
  "optionalDependencies": {
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.defterdar.app",
    "productName": "Defterdar",
    "copyright": "Copyright © 2026 Defterdar",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Defterdar",
      "artifactName": "Defterdar-Kurulum-${version}.${ext}"
    },
    "files": ["**/*", "!data/**", "!dist/**", "!*.md", "!test/**"]
  }
}
